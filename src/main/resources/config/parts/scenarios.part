# ==============================================================================
# Scenario & Tree Topology Configuration
# ==============================================================================

# Maximum scenario-tree depth allowed before a safeguard is triggered. Default: 20
# .tree.scenario.depth.safeguard=20

# ------------------------------------------------------------------------------
# Maximum scenario history depth retained before a safeguard is triggered. Default: 20
# .tree.scenario.history.depth.safeguard=20

# ------------------------------------------------------------------------------
# Number of attempts used when retrying scenario sufficiency checks. Default: 9
# .test.scenario.sufficiency.attempts=9

# ------------------------------------------------------------------------------
# Controls how strongly scenario selection favours unfinished work. Default: 4.5
# .tree.completion.weight=4.5

# ------------------------------------------------------------------------------
# Weight assigned to scenarios when no explicit weight is configured. Default: 0.0
# .tree.default.weight=0.0

# ------------------------------------------------------------------------------
# Default result used when a scenario fit cannot otherwise be determined. Default: false
# .tree.fits.by.default=false

# ------------------------------------------------------------------------------
# Allows execution to continue when selecting scenarios fails. Default: false
# .tree.ignore.failed.scenario.selection=false

# ------------------------------------------------------------------------------
# When true, leaf scenarios that have reached their target execution count are set to weight 0 and marked non-executable. Default: false
# .tree.forbid.overexecution=false

# ------------------------------------------------------------------------------
# Automatically prunes non-fitting scenarios and unreachable leaves when fits() returns false. Default: true
# .tree.unreachable.leaf.pruning=true

# ------------------------------------------------------------------------------
# Applies a selection weight penalty to unproductive branches that fail to yield executable leaves. Default: true
# .tree.branch.stale.penalty=true

# ------------------------------------------------------------------------------
# Hides branches of the test tree which are entirely OFF to reduce wasted space on partial test executions. Default: false
# .tree.hide.off.branches=false

# ------------------------------------------------------------------------------
# Displays debug coordinates and camera movement vector in tree progression frames. Default: false
# .tree.progression.debug=false

# ------------------------------------------------------------------------------
# Enables 16:9 layout optimization and compaction for scenario execution trees. Default: true
# .tree.progression.optimization=true

# ------------------------------------------------------------------------------
# Number of horizontal column banks to split independent scenario trees into when aspect ratio is narrow. Default: 2
# .tree.progression.optimization.bank.columns=2

# ------------------------------------------------------------------------------
# Aspect ratio threshold (width/height) below which multi-bank tree layout is activated. Default: 0.85
# .tree.progression.optimization.max.aspect.ratio=0.85

# ------------------------------------------------------------------------------
# Number of columns to split leaf children into during packing. Default: 2
# .tree.progression.optimization.pack.columns=2

# ------------------------------------------------------------------------------
# Maximum depth (columns) for a tree to be classified as shallow for layout packing. Default: 12
# .tree.progression.optimization.shallow.max.depth=12

# ------------------------------------------------------------------------------
# Minimum node-to-depth ratio for a tree to be classified as wide for layout packing. Default: 2.0
# .tree.progression.optimization.shallow.min.ratio=2.0

# ------------------------------------------------------------------------------
# Minimum leaf children count required to force multi-column packing in shallow-wide trees. Default: 2
# .tree.progression.optimization.shallow.threshold=2

# ------------------------------------------------------------------------------
# Minimum leaf children count required to force multi-column packing in standard trees. Default: 6
# .tree.progression.optimization.standard.threshold=6

# ==============================================================================
# Test Node Weight Propagation
# ==============================================================================

# Includes downstream test nodes when propagating or calculating test node weights. Default: false
# .tree.include.downstream=false

# ------------------------------------------------------------------------------
# Includes upstream test nodes when propagating or calculating test node weights. Default: false
# .tree.include.upstream=false

# ------------------------------------------------------------------------------
# Resolves inherited scenarios through their superclass chain when determining scenario weights. Default: false
# .tree.traverse.extensions=false

# ==============================================================================
# Scenario Sequence Script
# ==============================================================================

# How a scenario sequence script is applied to selection: SUGGESTION prefers the next scripted scenario and falls back to weighted selection, ORDER requires the scripted order. Default: SUGGESTION
# .tree.sequence.mode=SUGGESTION

# ------------------------------------------------------------------------------
# Severity used when a scripted scenario cannot be selected in ORDER mode. Default: S0
# .tree.sequence.failure.severity=S0

# ==============================================================================
# Notices and Warnings
# ==============================================================================

# Displays a notice when a scenario package contains no executable scenarios. Default: true
# .tree.notify.about.empty.scenario.packages=true

# ------------------------------------------------------------------------------
# Displays a notice when a scenario does not fit the current execution conditions. Default: true
# .tree.scenario.does.not.fit.notice=true

# ------------------------------------------------------------------------------
# Displays a notice when a scenario cannot be executed. Default: true
# .tree.scenario.not.executable.notice=true

# ==============================================================================
# Test Execution Configuration
# ==============================================================================

# Event severity level at which to stop test execution.
# Severity levels determine how severe an event must be to halt further testing.
.test.fail.by.event.of.severity=0

# Enables resilient mode where execution continues after exceptions to collect all failures.
# .test.resilient.mode=false

# ------------------------------------------------------------------------------
# Default number of tests to perform if not explicitly specified.
# .test.tests=99

# ------------------------------------------------------------------------------

# Defines the minimal execution time threshold for consecutive tests.
# Format: {number of tests}:{minimum time in milliseconds}.
# Default: 20 tests must take at least 2000 milliseconds.
# .tests.execution.time.safeguard=20|2000

# ------------------------------------------------------------------------------

# Number of retries for handling exceptional states during UI interactions.
# .test.exception.retries=3

# ------------------------------------------------------------------------------

# Whether to produce an exceptional state on failed assertions.
# .test.assertions.produce.exception=true

# Severity used when logging failed assertions (S0, S1, S2, or S3).
# .test.assertions.severity=s0